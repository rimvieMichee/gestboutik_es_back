# Base de données Supabase (Postgres managé) — voir Project Settings > Database > Connection string.
# DATABASE_URL : pooler en mode "Transaction" (port 6543), utilisé par l'application au runtime.
# DIRECT_URL   : pooler en mode "Session" (port 5432), utilisé par Prisma pour les migrations.
# Le host direct `db.<ref>.supabase.co` est IPv6-only sur les nouveaux projets ; utiliser le pooler
# pour les deux évite tout problème de connectivité IPv4.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<shard>-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-<shard>-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

PORT=3000
NODE_ENV=development

JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGINS="http://localhost:4200,http://localhost:4455"
